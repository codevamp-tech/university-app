# ──────────────────────────────────────────────────────────────
# UNIVERSITY APP — Environment Variables Template
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# Never commit .env to git.
# ──────────────────────────────────────────────────────────────

# UniCampus Backend API
EXPO_PUBLIC_API_BASE_URL=http://54.174.185.143:8000
EXPO_PUBLIC_TENANT_ID=d3b07384-d113-4956-a5db-e0e457e51c89
EXPO_PUBLIC_DEPT_ID=e0c46647-7ee9-4c12-97b7-580ea5d3bc7d

# Google Sheets – Spreadsheet ID
# Grab from the sheet URL: /spreadsheets/d/[ID]/edit
EXPO_PUBLIC_GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Google Gemini API Key
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Llama 3.3 70B)
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here
