{
  "expo": {
    "name": "UniCampus",
    "slug": "university-portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/unicampus-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/c85fea13-81f5-4c5c-8226-d7c955d6db37"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/unicampus-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F4FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.university.portal",
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSHealthShareUsageDescription": "UniCampus reads your steps, active calories, sleep, and mindful sessions to display your daily fitness metrics.",
        "NSHealthUpdateUsageDescription": "UniCampus saves your focus session duration to Apple Health."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/unicampus-icon.png",
        "backgroundColor": "#F0F4FF"
      },
      "package": "com.university.portal",
      "edgeToEdgeEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_SLEEP",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_SLEEP",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      [
        "expo-health-connect",
        {
          "permissions": [
            "READ_STEPS",
            "READ_ACTIVE_CALORIES_BURNED",
            "READ_SLEEP"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/unicampus-icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c85fea13-81f5-4c5c-8226-d7c955d6db37"
      }
    }
  }
}
